#!/bin/sh
# Pre-push hook for Armature Framework
# Runs tests and checks before allowing push

set -e

echo "🚀 Running pre-push checks..."
echo ""

# Refuse direct pushes to protected branches.
#
# Decided from the refs actually being pushed, which git supplies on stdin as
# "<local ref> <local sha> <remote ref> <remote sha>" per ref — NOT from
# `git symbolic-ref HEAD`. The old check read the checked-out branch, so it
# rejected any push made while `main` happened to be checked out even when the
# ref being pushed was something else entirely. Pushing a release tag was
# impossible for that reason: `git push origin v0.4.0` from `main` was refused
# although the ref was `refs/tags/v0.4.0` and no branch was being updated.
#
# stdin is consumed here, so it is captured first for anything added later.
pushed_refs=$(cat)

if printf '%s\n' "$pushed_refs" \
    | awk '{ print $3 }' \
    | grep -qE '^refs/heads/(main|master)$'; then
    echo "❌ Direct push to a protected branch (main/master) is not allowed!"
    echo "   Please create a pull request instead."
    echo ""
    exit 1
fi

# A delete (remote sha all zeros with a zero local sha) and a tag push do not
# need the compile/test gate below — nothing new is being introduced to a
# branch. Skip straight to allowing it.
if [ -n "$pushed_refs" ] && ! printf '%s\n' "$pushed_refs" \
    | awk '{ print $3 }' | grep -qE '^refs/heads/'; then
    echo "ℹ️  No branch refs in this push (tags only) — skipping compile/test gate."
    echo ""
    exit 0
fi

# 1. Run quick compile check
echo "🔨 Running cargo check..."
if ! cargo check -p armature-framework --features full-with-saml; then
    echo ""
    echo "❌ Cargo check failed!"
    echo "   Fix compilation errors before pushing."
    echo ""
    exit 1
fi
echo "✅ Cargo check passed"
echo ""

# 2. Run tests
echo "🧪 Running tests..."
if ! cargo test -p armature-framework --features full-with-saml; then
    echo ""
    echo "❌ Tests failed!"
    echo "   Fix failing tests before pushing."
    echo ""
    exit 1
fi
echo "✅ All tests passed"
echo ""

# 3. Run doc tests
echo "📚 Running doc tests..."
if ! cargo test --doc -p armature-framework --features full-with-saml; then
    echo ""
    echo "❌ Doc tests failed!"
    echo "   Fix failing doc tests before pushing."
    echo ""
    exit 1
fi
echo "✅ Doc tests passed"
echo ""

# 4. Supply-chain checks. A finding blocks the push: an advisory that is
# genuinely not applicable belongs in .cargo/audit.toml / deny.toml with a
# justification, not in a habit of pushing past red output.
audit_ran=false
if command -v cargo-audit >/dev/null 2>&1; then
    audit_ran=true
    echo "🔐 Running cargo audit..."
    if ! cargo audit; then
        echo ""
        echo "❌ cargo audit reported vulnerabilities!"
        echo "   Upgrade the affected dependency, or record a justified ignore"
        echo "   in .cargo/audit.toml, before pushing."
        echo ""
        exit 1
    fi
    echo "✅ cargo audit passed"
    echo ""
fi
if command -v cargo-deny >/dev/null 2>&1 && [ -f deny.toml ]; then
    audit_ran=true
    echo "🔐 Running cargo deny..."
    if ! cargo deny check advisories bans sources; then
        echo ""
        echo "❌ cargo deny reported problems!"
        echo "   Fix them (or record a justified exception in deny.toml) before pushing."
        echo ""
        exit 1
    fi
    echo "✅ cargo deny passed"
    echo ""
fi
if [ "$audit_ran" = false ]; then
    echo "⚠️  Neither cargo-audit nor cargo-deny is installed: dependency advisories"
    echo "   were NOT checked. Install one (CI runs cargo audit regardless):"
    echo "     cargo install cargo-audit --version 0.22.2 --locked"
    echo "     cargo install cargo-deny --version 0.20.2 --locked"
    echo ""
fi

# 5. Build documentation (quick check)
echo "📖 Checking documentation builds..."
if ! cargo doc -p armature-framework --features full-with-saml --no-deps --quiet; then
    echo ""
    echo "❌ Documentation build failed!"
    echo "   Fix doc errors before pushing."
    echo ""
    exit 1
fi
echo "✅ Documentation builds successfully"
echo ""

echo "✨ Pre-push checks complete! Safe to push."
echo ""

exit 0

