# Copy to .env (same directory) and set every value. Never commit .env.
# docker compose refuses to start while any of these is empty/unset.
# Generate each value with: openssl rand -hex 32
# (hex keeps them safe to embed in the connection URLs Compose builds).

POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
ELASTIC_PASSWORD=
JWT_SECRET=
