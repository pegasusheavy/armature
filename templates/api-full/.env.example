# Copy to .env and fill in. Never commit the filled-in .env.

# API Configuration
HOST=0.0.0.0
PORT=3000
ENVIRONMENT=development

# JWT Configuration
JWT_EXPIRY_HOURS=24
# REQUIRED, at least 32 bytes; the app refuses to start without it.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional development seed admin (admin@example.com). Leave SEED_ADMIN unset
# in any shared or production environment. If SEED_ADMIN_PASSWORD is empty a
# random password is generated (and not printed).
# SEED_ADMIN=true
# SEED_ADMIN_PASSWORD=

# Database (optional)
# Generate the password with: openssl rand -hex 32
POSTGRES_PASSWORD=
# DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@localhost:5432/api

# Redis (optional)
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=
# REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379

# Logging
RUST_LOG=info,api_full=debug
