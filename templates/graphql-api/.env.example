# Copy to .env and fill in. Never commit the filled-in .env.

# Server Configuration
HOST=127.0.0.1
PORT=3000

# GraphQL Configuration
GRAPHQL_PATH=/graphql
# The playground and introspection (including GET /graphql/schema) are off
# unless enabled; enable them for local development only.
GRAPHQL_PLAYGROUND=false
GRAPHQL_INTROSPECTION=false
GRAPHQL_DEPTH_LIMIT=10
GRAPHQL_COMPLEXITY_LIMIT=100

# Database / cache used by docker-compose.yml (required there).
# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Logging
RUST_LOG=info
