# =============================================================================
# Armature - Secret EXAMPLE (not part of the Kustomize base)
# =============================================================================
# This file is intentionally NOT listed in kustomization.yaml: applying a
# committed Secret with placeholder values would run the app with a public
# JWT signing key. Create the real Secret one of these ways instead:
#
#   1. External secret management (External Secrets Operator, Sealed Secrets,
#      Vault, cloud secret managers) producing a Secret with these keys.
#
#   2. kubectl, from freshly generated values (nothing touches disk):
#        kubectl -n armature create secret generic armature-api-secrets \
#          --from-literal=jwt-secret="$(openssl rand -hex 32)" \
#          --from-literal=database-url='postgres://...' \
#          --from-literal=redis-url='redis://:...@redis:6379'
#
#   3. A secretGenerator in YOUR overlay, reading an untracked env file:
#        secretGenerator:
#          - name: armature-api-secrets
#            envs: [secrets.env]   # gitignored; jwt-secret=..., etc.
#        generatorOptions:
#          disableNameSuffixHash: true
#
# Until the Secret exists, the Deployment's pods stay in
# CreateContainerConfigError (fail closed) instead of starting with a default.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: armature-api-secrets
  namespace: armature
  labels:
    app.kubernetes.io/name: armature-api
    app.kubernetes.io/managed-by: armature-cli
type: Opaque
stringData:
  # Database connection string
  database-url: ""
  # Redis connection string (include the password)
  redis-url: ""
  # JWT signing secret, >= 32 bytes. Generate with: openssl rand -hex 32
  jwt-secret: ""
