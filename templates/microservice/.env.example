# Copy to .env and fill in. Never commit the filled-in .env.

# Service Configuration
SERVICE_NAME=my-microservice
HOST=0.0.0.0
PORT=8080

# Redis Configuration
# REDIS_PASSWORD is required by docker-compose.yml.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=
# Include the password in the URL: redis://:<REDIS_PASSWORD>@localhost:6379
REDIS_URL=
QUEUE_NAME=jobs

# Worker Configuration
CONCURRENCY=4
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000

# Logging
RUST_LOG=info,microservice=debug
