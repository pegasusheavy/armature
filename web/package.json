{
  "name": "armature-web",
  "version": "0.1.0",
  "description": "Documentation website for Armature Framework",
  "author": "Joseph Quinn <quinn.josephr@proton.me>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/quinnjr/armature.git"
  },
  "homepage": "https://quinnjr.github.io/armature",
  "type": "module",
  "scripts": {
    "start": "astro dev",
    "dev": "astro dev",
    "build": "astro build",
    "build:prod": "astro build",
    "build:gh-pages": "ASTRO_BASE=/armature astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,astro}\"",
    "lint:fix": "eslint \"src/**/*.{ts,astro}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,astro,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,astro,css,scss,json}\"",
    "ci": "pnpm run lint && pnpm run format:check && pnpm run test:ci && pnpm run build:prod"
  },
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "astro": "^7.4.0",
    "marked": "^18.1.1",
    "sanitize-html": "^2.18.1",
    "tailswatch": "^1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sass": "^1.105.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "@parcel/watcher": "-",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "brace-expansion@<1.1.21": "^1.1.21",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "source-map-js@<1.2.2": "^1.2.2",
      "postcss-selector-parser@<7.1.6": "^7.1.6",
      "esbuild@<0.28.1": "^0.28.1",
      "sharp@<0.35.5": "^0.35.5",
      "devalue@<5.9.3": "^5.9.3",
      "svgo@<4.1.0": "^4.1.0",
      "postcss@<8.5.23": "^8.5.23",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "smol-toml@<1.9.0": "^1.9.0",
      "immutable@<5.1.8": "^5.1.8",
      "flatted@<3.4.2": "^3.4.2",
      "nanoid@<3.3.18": "^3.3.18",
      "minimatch@<3.1.4": "^3.1.4"
    }
  }
}
